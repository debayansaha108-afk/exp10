<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data Architecture Dashboard"
                android:textColor="#0F172A"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"
                android:layout_marginTop="16dp"/>

            <!-- SharedPreferences Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="#FFFFFF">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shared Preferences"
                        android:textColor="#334155"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/editSharedPrefs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="App Configurations"
                        android:padding="12dp"
                        android:background="#F1F5F9"
                        android:textColor="#0F172A"
                        android:textSize="16sp"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnCommitSettings"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Commit Settings"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#1E293B"
                            app:cornerRadius="8dp"
                            android:layout_marginEnd="8dp"/>

                        <Button
                            android:id="@+id/btnRestoreSettings"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Restore Settings"
                            android:textColor="#0F172A"
                            android:backgroundTint="#E2E8F0"
                            app:cornerRadius="8dp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSharedPrefsOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="#E0F2FE"
                        android:padding="12dp"
                        android:text="Cache state: Empty"
                        android:textColor="#0369A1"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SQLite Database Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="#FFFFFF">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SQLite Database"
                        android:textColor="#334155"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/editSqliteRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Structural database row..."
                        android:padding="12dp"
                        android:background="#F1F5F9"
                        android:textColor="#0F172A"
                        android:textSize="16sp"
                        android:layout_marginBottom="16dp"/>

                    <Button
                        android:id="@+id/btnExecuteInsert"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Execute Insert"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#4F46E5"
                        app:cornerRadius="8dp"
                        android:layout_marginBottom="20dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/border_bg"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Database Records"
                            android:textColor="#64748B"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tvSqliteOutput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No records found."
                            android:textColor="#334155"
                            android:textSize="14sp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <Space
                android:layout_width="match_parent"
                android:layout_height="40dp" />

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>